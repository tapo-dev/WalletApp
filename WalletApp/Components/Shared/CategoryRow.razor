@using WalletApp.Models
@using WalletApp.Services

<div class="card mb-3 shadow-sm">
    <div class="card-header d-flex justify-content-between align-items-center" 
         @onclick="ToggleSubcategories" 
         style="cursor: pointer; background-color: @CategoryData.Color; color: white;">
        
        <span class="fw-bold">@CategoryData.Name</span>
        <i class="bi @(_isExpanded ? "bi-chevron-up" : "bi-chevron-down")"></i>
    </div>

    @if (_isExpanded)
    {
        <div class="card-body">
            @if (CategoryData.Subcategories.Any())
            {
                <ul class="list-group list-group-flush mb-3">
                    @foreach (var subcategory in CategoryData.Subcategories)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span>@subcategory.Name</span>
                            <button class="btn btn-outline-danger btn-sm" 
                                    @onclick="() => RemoveSubcategory(subcategory)" 
                                    title="Remove subcategory">
                                <i class="bi bi-trash"></i>
                            </button>
                        </li>
                    }
                </ul>
            }
            else
            {
                <p class="text-muted fst-italic ms-2">No subcategories found.</p>
            }

            <form @onsubmit="SubmitNewSubcategory" class="d-flex gap-2 mt-2">
                <input type="text" class="form-control form-control-sm" 
                       placeholder="New subcategory..." 
                       @bind="_newSubcategoryName"/>
                <button type="submit" class="btn btn-secondary btn-sm">
                    <i class="bi bi-plus-lg"></i> Add
                </button>
            </form>
            
            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="text-danger small mt-1">@_errorMessage</div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public Category CategoryData { get; set; } = default!;
    
    [Inject] ICategoryService CategoryService { get; set; } = default!;
    [Inject] UserState UserState { get; set; } = default!;
    [Inject] NavigationManager NavigationManager { get; set; } = default!;
    
    // UI state
    private bool _isExpanded = false;
    private string _newSubcategoryName = string.Empty;
    private string _errorMessage = string.Empty;

    private void ToggleSubcategories() {
        _isExpanded = !_isExpanded;
    }

    private async Task SubmitNewSubcategory() {
        if (string.IsNullOrEmpty(_newSubcategoryName)) {
            _errorMessage = "Empty input field";
            return;
        }

        try {
            var user = UserState.CurrentUser;
            if (user == null) {
                NavigationManager.NavigateTo("/login");
                return;
            }
            
            _errorMessage = string.Empty;
            var newSubcategory = new Subcategory() 
                { Name = _newSubcategoryName, CategoryId = CategoryData.Id, UserId = user.Id };
            
            await CategoryService.AddSubCategoryAsync(newSubcategory);

            // Clear input
            _newSubcategoryName = string.Empty;
            
            // Refresh data to show the new subcategory immediately
            var updatedCategories = await CategoryService.GetCategoriesAsync(user.Id);
            var updatedMe = updatedCategories.FirstOrDefault(c => c.Id == CategoryData.Id);
            if(updatedMe != null)
            {
                CategoryData.Subcategories = updatedMe.Subcategories;
            }
        }
        catch (Exception ex) {
            _errorMessage = "Error creating subcategory";
            Console.WriteLine($"Error in saving subcategory: {ex.Message}");
        }
    }
    
    private async Task RemoveSubcategory(Subcategory subcategory) {
        try {
            await CategoryService.RemoveSubcategoryAsync(subcategory);
            
             // Refresh data after deletion
            var user = UserState.CurrentUser;
            if (user != null) {
                var updatedCategories = await CategoryService.GetCategoriesAsync(user.Id);
                var updatedMe = updatedCategories.FirstOrDefault(c => c.Id == CategoryData.Id);
                if(updatedMe != null)
                {
                    CategoryData.Subcategories = updatedMe.Subcategories;
                }
            }
        }
        catch (Exception ex) {
            Console.WriteLine($"Error removing subcategory: {ex.Message}");
            _errorMessage = "Error removing subcategory";
        }
    }
}