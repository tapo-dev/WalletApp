@using WalletApp.Models
@using WalletApp.Services

<li @onclick="ToggleSubcategories" style="cursor: pointer;"> 
    @CategoryData.Name
</li>
@if (_isExpanded) {
    if (CategoryData.Subcategories.Any()) {
        <ul>@foreach (var subcategory in CategoryData.Subcategories) {
                <li>
                    @subcategory.Name
                </li>
            }
        </ul>
    }
    else {
        <p>@_errorMessage</p>
    }
    <input type="text" @bind="_newSubcategoryName"/>
    <button @onclick="SubmitNewSubcategory">Add new subcategory</button>
}

@code {
    [Parameter] public Category CategoryData { get; set; } = default!;
    [Inject] public ICategoryService CategoryService { get; set; } = default!;

    private bool _isExpanded = false;
    private string _newSubcategoryName = string.Empty;
    private string _errorMessage = "No subcategories found";

    public void ToggleSubcategories() {
        _isExpanded = !_isExpanded;
    }

    private async Task SubmitNewSubcategory() {
        if (_newSubcategoryName.Any()) {
            var newSubcategory = new Subcategory() { Name = _newSubcategoryName, CategoryId = CategoryData.Id};
            await CategoryService.AddSubCategoryAsync(newSubcategory);
            
            // Empty the strings
            _newSubcategoryName = string.Empty;
            _errorMessage = string.Empty;
        }
    }
}