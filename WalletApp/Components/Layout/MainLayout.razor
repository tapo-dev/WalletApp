@inherits LayoutComponentBase
@using WalletApp.Services
@implements IDisposable

<div class="page">
    <div class="sidebar">
        <NavMenu/>
    </div>

    <main>
        <div class="top-row px-4">
            @if (UserState.CurrentUser != null) {
                <span class="me-3">Welcome, <b>@UserState.CurrentUser.Name</b></span>
                <button class="btn btn-link" @onclick="SubmitLogout">Logout</button>
            }
            else {
                <a href="login" class="ms-3">Login</a>
                <a href="register" class="ms-3">Register</a>
            }
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    [Inject] UserState UserState { get; set; } = default!;
    [Inject] NavigationManager NavigationManager { get; set; } = default!;

    protected override void OnInitialized() {
        UserState.OnChange += StateHasChanged;
    }

    public void Dispose() {
        UserState.OnChange -= StateHasChanged;
    }

    private void SubmitLogout() { // Nemusí být async, logout je v paměti
        try {
            UserState.LogoutUser();
            NavigationManager.NavigateTo("/login");
        }
        catch (Exception ex) {
            Console.WriteLine($"An error has occured during logout: {ex.Message}");
        }
    }
}