@page "/history"
@using SQLitePCL
@using WalletApp.Models
@using WalletApp.Services

<PageTitle>History</PageTitle>
@if (_expenses.Any()) {
    <table class="table">
        <thead> <tr>
            <th>Name</th>
            <th>Amount</th>
            <th>Category</th>
            <th>Subcategory</th>
            <th>Date added</th>
            <th></th>
        </tr>
        </thead>
        <tbody>
            @foreach (var expense in _expenses) {
                <tr>
                    <td>@expense.Name</td>
                    <td>@expense.Amount</td>
                    <td>@expense.Subcategory.Category.Name</td>
                    <td>@expense.Subcategory.Name</td>
                    <td>@expense.DateAdded.ToShortDateString()</td>
                    <td>
                        <button class="btn btn-outline-secondary btn-sm me-2" @onclick='() => NavigationManager.NavigateTo($"edit-expense/{expense.Id}")'>
                            <i class="bi bi-pencil"></i>
                        </button>

                        <button class="btn btn-outline-danger btn-sm" @onclick="() => ConfirmDelete(expense.Id)">
                            <i class="bi bi-trash"></i>
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else {
    <p>No expenses added yet</p>
}

@code {
    [Inject] IExpenseService ExpenseService { get; set; } = default!;
    [Inject] UserState UserState { get; set; } = default!;
    [Inject] NavigationManager NavigationManager { get; set; } = default!;

    private List<Expense> _expenses = new List<Expense>();

    protected override async Task OnInitializedAsync() {
        try {
            await base.OnInitializedAsync();

            var user = UserState.CurrentUser;
            if (user == null) {
                NavigationManager.NavigateTo("/login");
                return;
            }

            var rawExpenses = await ExpenseService.GetAllExpensesAsync(user.Id);
            _expenses = rawExpenses.OrderByDescending(e => e.DateAdded).ToList();
        }
        catch (Exception ex) {
            Console.WriteLine($"Error in initializing ExpenseHistory page: {ex.Message}");
        }
    }

    private async Task ConfirmDelete(int expenseId) {
        try {
            var user = UserState.CurrentUser;
            if (user == null) {
                NavigationManager.NavigateTo("/login");
                return;
            }

            await ExpenseService.DeleteExpenseAsync(expenseId);
            _expenses = await ExpenseService.GetAllExpensesAsync(user.Id);
        }
        catch (Exception ex) {
            Console.WriteLine($"Error in removing expense: {ex.Message}");
        }
    }
}