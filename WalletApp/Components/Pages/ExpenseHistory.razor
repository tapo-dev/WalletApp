@page "/history"
@using WalletApp.Models
@using WalletApp.Services
@rendermode InteractiveServer
<h3>ExpenseHistory</h3>

@if (_expenses.Any()) {
    <table class="table">
        <thead> <tr>
            <th>Name</th>
            <th>Amount</th>
            <th>Subcategory</th>
            <th>Date added</th>
        </tr>
        </thead>
        <tbody>
            @foreach (var expense in _expenses) {
                <tr>
                    <td>@expense.Name</td>
                    <td>@expense.Amount</td>
                    <td>@expense.Subcategory.Name</td>
                    <td>@expense.DateAdded</td>
                </tr>
            }
        </tbody>
    </table>
}
else {
    <p>No expenses added yet</p>
}

@code {
    [Inject] IExpenseService ExpenseService { get; set; } = default!;
    
    private List<Expense> _expenses = new List<Expense>();
    
    private string _errorMessage = string.Empty;

    protected override async Task OnInitializedAsync() {
        try {
            _expenses = await ExpenseService.GetAllExpensesAsync();
            await base.OnInitializedAsync();
        }
        catch (Exception ex) {
            Console.WriteLine($"Error in initializing ExpenseHistory page: {ex.Message}");
        }
    }
}