@page "/add-expense"
@using WalletApp.Models
@using WalletApp.Services
@rendermode InteractiveServer
<h3>Add Expense</h3>
<!-- Form for adding an expense -->
<p>Category</p>
<select @bind="_category.Id" @bind:after="OnCategorySelectedAsync">
    <option value="0">Choose category...</option>
    @foreach (var category in _allCategories) {
        <option value="@category.Id">@category.Name</option>
    }
</select>
<p>Subcategory</p>
<select @bind="_newExpense.SubcategoryId">
    <option value="0">Choose subcategory...</option>
    @foreach (var sub in _subcategories) {
        <option value="@sub.Id">@sub.Name</option>
    }
</select>
<p>Name (optional)</p>
<input type="text" @bind="_newExpense.Name"/>
<p>Amount</p>
<input type="number" @bind="_newExpense.Amount"/>
<button @onclick="SubmitNewExpense">Add expense</button>
<p>@_errorMessage</p>

@code {
    [Inject] public ICategoryService CategoryService { get; set; } = default!;
    [Inject] public IExpenseService ExpenseService { get; set; } = default!;

    private List<Subcategory> _subcategories = new List<Subcategory>();
    private List<Category> _allCategories = new List<Category>();

    private Category _category = new Category();
    private Expense _newExpense = new Expense();

    private string _errorMessage = string.Empty;
    
    // TODO: Remove after making login and register pages
    private int temporaryUserIdForTesting = 1;

    protected override async Task OnInitializedAsync() {
        try {
            await base.OnInitializedAsync();
            _allCategories = await CategoryService.GetCategoriesAsync(temporaryUserIdForTesting);
        }
        catch (Exception ex) {
            Console.WriteLine($"Error in initializing AddExpense page: {ex.Message}");
        }
    }

    private async Task SubmitNewExpense() {
        if (_newExpense.SubcategoryId == 0 || _newExpense.Amount <= 0) {
            _errorMessage = "Empty input field";
            return;
        }

        try {
            _errorMessage = string.Empty;
            _newExpense.DateAdded = DateTime.Now;
            _newExpense.UserId = temporaryUserIdForTesting;

            // Adds new expense
            await ExpenseService.AddExpenseAsync(_newExpense);

            // Submitted succesfully -> clean
            _newExpense = new Expense();
        }
        catch (Exception ex) {
            _errorMessage = "An error has occured during creating your expense";
            Console.WriteLine($"Error in saving expense: {ex.Message}");
        }
    }

    private async Task OnCategorySelectedAsync() {
        try {
            _newExpense.SubcategoryId = 0;
            _subcategories = await CategoryService.GetSubcategoriesFromCategoryAsync(_category.Id, temporaryUserIdForTesting);
        }
        catch (Exception ex) {
            _errorMessage = "An error has occured during selecting your category";
            Console.WriteLine($"Error in selecting category: {ex.Message}");
        }
    }
}