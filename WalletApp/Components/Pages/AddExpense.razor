@page "/add-expense"
@using WalletApp.Models
@using WalletApp.Services
@rendermode InteractiveServer
<h3>Add Expense</h3>

<p>Category</p>
<select @bind="_category.Id" @bind:after="OnCategorySelectedAsync">
    <option value="0">Choose category...</option>
    @foreach (var category in _allCategories) {
        <option value="@category.Id">@category.Name</option>
    }
</select>
<p>Subcategory</p>
<select @bind="_newExpense.SubcategoryId">
    <option value="0">Choose subcategory...</option>
    @foreach (var sub in _subcategories) {
        <option value="@sub.Id">@sub.Name</option>
    }
</select>
<p>Name (optional)</p>
<input type="text" @bind="_newExpense.Name"/>
<p>Amount</p>
<input type="number" @bind="_newExpense.Amount"/>
<button @onclick="SubmitNewExpense">Add expense</button>

@code {
    [Inject] public ICategoryService CategoryService { get; set; } = default!;
    [Inject] public IExpenseService ExpenseService { get; set; } = default!;

    private List<Subcategory> _subcategories = new List<Subcategory>();
    private List<Category> _allCategories = new List<Category>();

    private Category _category = new Category();
    private Expense _newExpense = new Expense();

    private string _errorMessage = string.Empty;

    protected override async Task OnInitializedAsync() {
        await base.OnInitializedAsync();
        _allCategories = await CategoryService.GetCategoriesAsync();
    }

    private async Task SubmitNewExpense() {
        if (_newExpense.SubcategoryId != 0 && !float.IsNaN(_newExpense.Amount)) {
            await ExpenseService.AddExpenseAsync(_newExpense);

            _newExpense = new Expense();
            _errorMessage = string.Empty;
        }
        else {
            _errorMessage = "Empty input field";
        }
    }

    private async Task OnCategorySelectedAsync() {
        _subcategories = await CategoryService.GetSubcategoriesFromCategoryAsync(_category);
    }
}