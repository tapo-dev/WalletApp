@page "/add-expense"
@using WalletApp.Models
@using WalletApp.Services

<PageTitle>Add expense</PageTitle>
<h3>Add Expense</h3>
<form @onsubmit="SubmitNewExpense">
    <p>Category</p>
    <select @bind="_category.Id" @bind:after="OnCategorySelectedAsync">
        <option value="0">Choose category...</option>
        @foreach (var category in _allCategories) {
            <option value="@category.Id">@category.Name</option>
        }
    </select>
    <p>Subcategory</p>
    <select @bind="_newExpense.SubcategoryId">
        <option value="0">Choose subcategory...</option>
        @foreach (var sub in _subcategories) {
            <option value="@sub.Id">@sub.Name</option>
        }
    </select>
    <p>Name (optional)</p>
    <input type="text" @bind="_newExpense.Name"/>
    <p>Amount</p>
    <input type="number" step="0.01" @bind="_newExpense.Amount"/>
    <button type="submit">Add expense</button>
    <p>@_errorMessage</p>
</form>

@code {
    // Dependency injection
    [Inject] ICategoryService CategoryService { get; set; } = default!;
    [Inject] IExpenseService ExpenseService { get; set; } = default!;
    [Inject] UserState UserState { get; set; } = default!;
    [Inject] NavigationManager NavigationManager { get; set; } = default!;

    private List<Category> _allCategories = new();
    // List of all subcategories from selected category
    private List<Subcategory> _subcategories = new();

    private Category _category = new();
    private Expense _newExpense = new();

    private string _errorMessage = string.Empty;

    protected override async Task OnInitializedAsync() {
        try {
            await base.OnInitializedAsync();
            
            var user = UserState.CurrentUser;
            if (user == null) {
                NavigationManager.NavigateTo("/login");
                return;
            }
            
            _allCategories = await CategoryService.GetCategoriesAsync(user.Id);
        }
        catch (Exception ex) {
            Console.WriteLine($"Error in initializing AddExpense page: {ex.Message}");
        }
    }

    private async Task SubmitNewExpense() {
        if (_newExpense.SubcategoryId == 0 || _newExpense.Amount <= 0) {
            _errorMessage = "Empty input field";
            return;
        }

        try {
            var user = UserState.CurrentUser;
            if (user == null) {
                NavigationManager.NavigateTo("/login");
                return;
            }
            
            _errorMessage = string.Empty;
            _newExpense.DateAdded = DateTime.Now;
            _newExpense.UserId = user.Id;

            // Adds new expense
            await ExpenseService.AddExpenseAsync(_newExpense);

            // Submitted succesfully -> clean
            _newExpense = new Expense();
        }
        catch (Exception ex) {
            _errorMessage = "An error has occured during creating your expense";
            Console.WriteLine($"Error in saving expense: {ex.Message}");
        }
    }

    private async Task OnCategorySelectedAsync() {
        try {
            var user = UserState.CurrentUser;
            if (user == null) {
                NavigationManager.NavigateTo("/login");
                return;
            }
            _newExpense.SubcategoryId = 0;
            _subcategories = await CategoryService.GetSubcategoriesFromCategoryAsync(_category.Id, user.Id);
        }
        catch (Exception ex) {
            _errorMessage = "An error has occured during selecting your category";
            Console.WriteLine($"Error in selecting category: {ex.Message}");
        }
    }
}