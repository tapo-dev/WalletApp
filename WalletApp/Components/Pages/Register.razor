@page "/register"
@using WalletApp.Models
@using WalletApp.Services

<form @onsubmit="SubmitNewUser">
    <p>Username:</p>
    <input type="text" @bind="@_newUsername"/>
    <p>Password:</p>
    <input type="password" @bind="@_newPassword"/>
    <p>Confirm password:</p>
    <input type="password" @bind="@_newConfirmedPassword"/>
    <button type="submit">Create account</button>
    <p>@_errorMessage</p>
</form>

@code {
    [Inject] IUserService UserService { get; set; } = default!;
    [Inject] UserState UserState { get; set; } = default!;
    [Inject] NavigationManager NavigationManager { get; set; } = default!;
    
    private string _newUsername = string.Empty;
    private string _newPassword = string.Empty;
    private string _newConfirmedPassword = string.Empty;
    private string _errorMessage = string.Empty;

    private async Task SubmitNewUser() {
        try {
            if (_newPassword != _newConfirmedPassword) {
                _errorMessage = "Passwords are not matching";
                return;
            }

            if (string.IsNullOrEmpty(_newUsername) ||
                string.IsNullOrEmpty(_newPassword) ||
                string.IsNullOrEmpty(_newConfirmedPassword)) {
                _errorMessage = "Empty input field";
                return;
            }

            var newUser = await UserService.RegisterUserAsync(_newUsername, _newPassword);

            if (newUser != null) {
                // Autologin
                UserState.SetUser(newUser);
                NavigationManager.NavigateTo("/");
            }
            else {
                _errorMessage = "User already exists";
            }
        }
        catch (Exception ex) {
            Console.WriteLine($"Error in registering User: {ex.Message}");
            _errorMessage = "An error has occured during your registration";
        }
    }
}