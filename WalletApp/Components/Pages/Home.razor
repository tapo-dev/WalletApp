@page "/"
@using WalletApp.Services
@using ApexCharts
@using WalletApp.Models
@using WalletApp.Models.DTOs

<PageTitle>Home</PageTitle>
<p>Total amount: @_totalAmount.ToString("C")</p>

<div class="row">
    <div class="col-md-6">
        <!-- Buttons for last Last week/Last month/Last year's -->
        <div class="btn-group mb-3" role="group">
            <button type="button" 
                    class="btn @(_selectedTimeRange == TimeRange.Week ? "btn-primary" : "btn-outline-primary")"
                    @onclick="() => ChangeTimeRange(TimeRange.Week)">
                Last Week
            </button>

            <button type="button" 
                    class="btn @(_selectedTimeRange == TimeRange.Month ? "btn-primary" : "btn-outline-primary")"
                    @onclick="() => ChangeTimeRange(TimeRange.Month)">
                Last Month
            </button>

            <button type="button" 
                    class="btn @(_selectedTimeRange == TimeRange.Year ? "btn-primary" : "btn-outline-primary")"
                    @onclick="() => ChangeTimeRange(TimeRange.Year)">
                Last Year
            </button>
        </div>

        <!-- Pie graph -->
        <div style="width: 80%">
            <ApexChart @ref="_chart" TItem="GraphData" OnDataPointSelection="HandleChartClick"
                       Title="Pie chart" Options=options>

                <ApexPointSeries TItem="GraphData"
                                 Items="_totalOfCategoriesList"
                                 Name="Gross Value"
                                 SeriesType="SeriesType.Pie"
                                 XValue="@(c => c.Name)"
                                 YAggregate="@(c => c.Sum(c => (decimal) c.Amount))"
                                 OrderByDescending="e=>e.Y"
                                 ShowDataLabels />
            </ApexChart>
        </div>
        
        <h3>Recent transactions</h3>
        <table class="table">
            <thead>
            <tr>
                <th>Category</th>
                <th>Amount</th>
                <th>Date</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var expense in _expenses
                          .Where(e => _currentCategorySelected == string.Empty || e.Subcategory.Category.Name == _currentCategorySelected)
                          .Take(5)) {
                <tr>
                    <td>@expense.Subcategory.Category.Name</td>
                    <td>@expense.Amount.ToString("C")</td>
                    <td>@expense.DateAdded.ToShortDateString()</td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    <div class="col-md-6">
        <h3>Listed values for the pie chart</h3>
        <table class="table">
            <thead>
            <tr>
                <th>Category</th>
                <th>Amount</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var category in _totalOfCategories) {
                <tr>
                    <td>@category.Key</td>
                    <td>@category.Value.ToString("C")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

@code {
    // Dependency injections
    [Inject] IStatisticsService StatisticsService { get; set; } = default!;
    [Inject] UserState UserState { get; set; } = default!;
    [Inject] NavigationManager NavigationManager { get; set; } = default!;
    [Inject] IApexChartService ApexChartService { get; set; } = default!;
    [Inject] IExpenseService ExpenseService { get; set; } = default!;
    
    // Total amount of all expenses
    private double _totalAmount;
    // For current selected category when you click on the graph
    private string _currentCategorySelected = string.Empty; //
    // Total amount for every category <Category, amount>
    private Dictionary<string, double> _totalOfCategories = new();
    // TimeRange for selecting Last week/Last month/Last year's expenses to show in graph
    private TimeRange _selectedTimeRange = TimeRange.Month;
    // Same as _totalOfCategories, but made for ApexCharts as a List with DTO GraphData
    private List<GraphData> _totalOfCategoriesList = new();
    // List of all expenses
    private List<Expense> _expenses = new();
    
    // Apexcharts graph necessities
    private ApexChartOptions<GraphData> options { get; set; } = new();
    private ApexChart<GraphData> _chart;

    protected override async Task OnInitializedAsync() {
        try {
            await base.OnInitializedAsync();
            
            // Apexcharts graph necessities
            options.DataLabels = new DataLabels
            {
                Formatter = @"function(value, { seriesIndex, w }) {
            return w.config.series[seriesIndex];}"
            };
            
            var user = UserState.CurrentUser;
            if (user == null) {
                NavigationManager.NavigateTo("/login");
                return;
            }

            // To sort the list from latest expenses
            var rawExpenses = await ExpenseService.GetAllExpensesAsync(user.Id);
            _expenses = rawExpenses.OrderByDescending(e => e.DateAdded).ToList();

            await LoadDataAsync();
        }
        catch (Exception ex) {
            Console.WriteLine($"Error in initializing homepage: {ex.Message}");
        }
    }

    private async Task LoadDataAsync() {
        try {
            var user = UserState.CurrentUser;
            if (user == null) {
                NavigationManager.NavigateTo("/login");
                return;
            }

            DateTime startDate = DateTime.Now.AddMonths(-1);
            switch (_selectedTimeRange) {
                case TimeRange.Year:
                    startDate = DateTime.Now.AddYears(-1);
                    break;
                case TimeRange.Month:
                    startDate = DateTime.Now.AddMonths(-1);
                    break;
                case TimeRange.Week:
                    startDate = DateTime.Now.AddDays(-7);
                    break;
            }
            
            _totalOfCategories = await StatisticsService
                .GetCategoryTotalsByDateAsync(startDate, user.Id);

            _totalAmount = _totalOfCategories.Values.Sum();
            
            _totalOfCategoriesList.Clear(); // Just in case
            foreach (var category in _totalOfCategories) {
                var graphData = new GraphData(category.Key, category.Value);
                _totalOfCategoriesList.Add(graphData);
            }
            
            if (_chart != null) {
                await _chart.UpdateSeriesAsync(true);
            }
        }
        catch (Exception ex) {
            Console.WriteLine($"Error in loading data on homepage: {ex.Message}");
        }
    }

    private async Task ChangeTimeRange(TimeRange timeRange) {
        _selectedTimeRange = timeRange;
        await LoadDataAsync();
    }

    private void HandleChartClick(SelectedData<GraphData> data) {
        if (_currentCategorySelected == (string) data.DataPoint.X) {
            _currentCategorySelected = string.Empty;
        }
        else {
            _currentCategorySelected = (string) data.DataPoint.X;
        }
    }
}