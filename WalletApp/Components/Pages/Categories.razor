@page "/categories"
@using WalletApp.Services
@using WalletApp.Models
@using WalletApp.Components.Shared

<PageTitle>Categories</PageTitle>

<div class="row mb-4">
    <div class="col-md-8">
        <form @onsubmit="SubmitNewCategory" class="d-flex gap-2">
            <input type="text" class="form-control" placeholder="New category name..." @bind="_newCategory"/>
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-plus-lg"></i> Add Category
            </button>
        </form>
        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="alert alert-danger mt-2">@_errorMessage</div>
        }
    </div>
</div>

@if (_categoriesList.Any()) {
    <div class="row">
        <div class="col-md-8">
            @foreach(var category in _categoriesList)
            {
                <div class="mb-4">
                    <CategoryRow CategoryData="@category"/>
                    
                    <div class="text-end">
                        <button class="btn btn-link text-danger text-decoration-none btn-sm" 
                                @onclick="() => RemoveCategory(category)"
                                title="Delete entire category">
                            <i class="bi bi-trash"></i> Delete Category "@category.Name"
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
}
else
{
    <p class="text-muted">No categories found. Start by adding one above.</p>
}

@code {
    // Dependency Injection
    [Inject] ICategoryService CategoryService { get; set; } = default!;
    [Inject] UserState UserState { get; set; } = default!;
    [Inject] NavigationManager NavigationManager { get; set; } = default!;

    private List<Category> _categoriesList = [];

    private string _newCategory = string.Empty;
    private string _errorMessage = string.Empty;
    
    // Default color for new categories (Bootstrap Primary Blue)
    private const string DefaultColor = "#0d6efd";

    protected override async Task OnInitializedAsync() {
        try {
            await base.OnInitializedAsync();
            var user = UserState.CurrentUser;
            if (user == null) {
                NavigationManager.NavigateTo("/login");
                return;
            }
            
            _categoriesList = await CategoryService.GetCategoriesAsync(user.Id);
        }
        catch (Exception ex) {
            Console.WriteLine($"Error initializing Categories page: {ex.Message}");
        }
    }

    private async Task SubmitNewCategory() {
        // Validation
        if (string.IsNullOrEmpty(_newCategory)) {
            _errorMessage = "Input cannot be empty";
            return;
        }

        try {
            _errorMessage = string.Empty;
            var user = UserState.CurrentUser;
            
            // Session check
            if (user == null) {
                NavigationManager.NavigateTo("/login");
                return;
            }

            var newCategory = new Category() { Name = _newCategory, Color = DefaultColor, UserId = user.Id};
            await CategoryService.AddCategoryAsync(newCategory);

            // Success: Clean input and refresh list
            _newCategory = string.Empty;
            _categoriesList = await CategoryService.GetCategoriesAsync(user.Id);
        }
        catch (Exception ex) {
            _errorMessage = "An error occurred while creating the category";
            Console.WriteLine($"Error saving category: {ex.Message}");
        }
    }

    private async Task RemoveCategory(Category category) {
        try {
            await CategoryService.RemoveCategoryAsync(category);
            
            var user = UserState.CurrentUser;
            if (user != null) {
                _categoriesList = await CategoryService.GetCategoriesAsync(user.Id);
            }
        }
        catch (Exception ex) {
            Console.WriteLine($"Error removing category: {ex.Message}");
            _errorMessage = "An error occurred while removing the category";
        }
    }
}